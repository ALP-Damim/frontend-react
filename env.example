# 환경변수 설정 (4개로 간소화)
# ======================================

# 1. 메인 API 서버 URL (Azure APIM 루트)
VITE_API_SERVER_URL=https://team02-apim.azure-api.net

# 2. 알림 HTTP API 베이스 (Azure APIM)
VITE_NOTIFICATION_API_URL=https://team02-apim.azure-api.net/notifications-service-http

# 3. 프론트엔드가 사용할 API 베이스 URL
#    예) 학생/수업 조회 등
VITE_API_BASE_URL=https://team02-apim.azure-api.net/student

# 운영(.env.production)에서 프록시를 사용하지 않으므로 절대 URL 유지

# 4. WebSocket 전체 URL
VITE_WEBSOCKET_URL=wss://team02-apim.azure-api.net/ws

# 5. Azure APIM 구독키 (옵션: 있으면 자동으로 붙음)
VITE_APIM_SUBSCRIPTION_KEY=
# 구독키 쿼리 파라미터 이름 (기본: subscription-key)
VITE_APIM_SUBSCRIPTION_QUERY_NAME=subscription-key

# ======================================
# 자동 생성되는 환경변수들
# ======================================

# Vite 프록시용 (개발 환경에서만 사용)
# 기존 프록시(/api)는 절대 URL을 쓰는 경우 생략 가능

# 알림 API용
# VITE_NOTIFICATION_API_URL 설정됨

# WebSocket용
# VITE_WEBSOCKET_URL 설정됨

# Nginx용 (배포 시 참고)
# API_BASE_URL = VITE_API_SERVER_URL
# API_HOST = VITE_API_SERVER_URL에서 호스트 추출
# NOTIFICATION_API_URL = VITE_NOTIFICATION_API_URL
# WEBSOCKET_URL = VITE_WEBSOCKET_URL

# ======================================
# 배포 환경 예시:
# ======================================
# VITE_API_SERVER_URL=https://api.yourdomain.com
# VITE_NOTIFICATION_SERVER_URL=https://notification.yourdomain.com
# VITE_API_BASE_PATH=/api
# VITE_WEBSOCKET_PATH=/ws
